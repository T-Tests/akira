# TMDB: use the "API Read Access Token" (v4 bearer) from themoviedb.org settings
TMDB_READ_TOKEN=
# Supabase secret key (legacy env var name; scripts only, never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase publishable key (legacy env var name; public, RLS still applies)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: link shown as "Report a wrong rating" (e.g. https://github.com/<you>/akira/issues/new)
NEXT_PUBLIC_REPORT_URL=
# LLM tagging: Ollama Cloud via its OpenAI-compatible endpoint (key from ollama.com/settings/keys)
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:20b-cloud
# Optional auditor model for --auto (a different model family gives a stronger cross-check).
LLM_AUDIT_BASE_URL=https://ollama.com/v1
LLM_AUDIT_API_KEY=
LLM_AUDIT_MODEL=gemma4:cloud
