# TMDB: use the "API Read Access Token" (v4 bearer) from themoviedb.org settings
TMDB_READ_TOKEN=
# Supabase (service role key is for scripts ONLY - never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Frontend (public, safe to expose; leave blank for demo mode with bundled seed data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: link shown as "Report a wrong rating" (e.g. https://github.com/<you>/akira/issues/new)
NEXT_PUBLIC_REPORT_URL=
# LLM tagging: Google Gemini free tier via its OpenAI-compatible endpoint (key from aistudio.google.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
